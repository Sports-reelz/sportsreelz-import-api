# SPORTSREELZ Video Import Service Configuration

# API key for authenticating requests from SPORTSREELZ platform
API_KEY=your-secure-api-key-here

# SPORTSREELZ upload API endpoint (provided by Ryan's dev team)
SPORTSREELZ_UPLOAD_URL=https://api.sportsreelz.com/api/import/upload

# Max concurrent downloads (default: 3)
MAX_WORKERS=3

# Normalize all videos to 1080p 16:9 (default: true)
NORMALIZE_VIDEO=true

# Direct S3 upload — set S3_BUCKET to enable. When set, the API uploads the
# downloaded video straight into this bucket and download_url is populated
# with the resulting S3 URL. This is the recommended path for SPORTSREELZ —
# point it at sportsreelz-input (staging) or sreelz-input (production).
S3_BUCKET=

# AWS credentials for the S3 upload above
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Set true to make uploaded objects publicly readable. Leave false to receive
# a 7-day presigned URL instead (default).
S3_PUBLIC=false

# ── yt-dlp cookies (for YouTube anti-bot bypass) ─────────────────────────────
# YouTube has rolled out aggressive bot detection. If you see
# "Sign in to confirm you're not a bot" errors on YouTube imports, point this
# at a cookies.txt file exported from a signed-in YouTube session.
#
# How to export:
#   1. Install the "Get cookies.txt LOCALLY" Chrome extension
#   2. Sign in to youtube.com in Chrome
#   3. Click the extension on youtube.com -> Export
#   4. Save the file somewhere on the API server
#   5. Set the path below
#
# IMPORTANT FOR DOCKER / SERVER:
# - The value must be the path *inside the container*.
# - Default for this project (see Dockerfile): /app/cookies/youtube_cookies.txt
# - You must also mount the file from the host using docker-compose volumes, e.g.:
#     volumes:
#       - ./cookies/youtube_cookies.txt:/app/cookies/youtube_cookies.txt:ro
# - Then in the server's .env (the one next to docker-compose on the host):
#     YT_DLP_COOKIES_FILE=/app/cookies/youtube_cookies.txt
YT_DLP_COOKIES_FILE=/app/cookies/youtube_cookies.txt

# Alternative: have yt-dlp read cookies directly from a browser installed on
# the API host. Acceptable values: chrome, firefox, edge, brave, opera, vivaldi.
# Only used when YT_DLP_COOKIES_FILE is empty.
YT_DLP_COOKIES_FROM_BROWSER=

# ── Job state persistence ────────────────────────────────────────────────────
# Where the API writes its in-memory jobs dict so that client poll requests
# don't see "Job not found" after a docker-compose restart or container
# redeploy. Mount this path as a Docker volume in production so it survives
# container lifecycle events.
#
# Default: ./data/jobs.json (relative to the working dir)
JOBS_FILE=

# How frequently the background thread flushes the jobs dict to disk, in
# seconds. Lower = fewer state losses on crash but more disk writes.
# Default: 2.0
JOBS_PERSIST_INTERVAL=
