# SPORTSREELZ Video Import Service Configuration

# API key for authenticating requests from SPORTSREELZ platform
API_KEY=your-secure-api-key-here

# SPORTSREELZ upload API endpoint (provided by Ryan's dev team)
SPORTSREELZ_UPLOAD_URL=https://api.sportsreelz.com/api/import/upload

# Max concurrent downloads (default: 3)
MAX_WORKERS=3

# Normalize all videos to 1080p 16:9 (default: true)
NORMALIZE_VIDEO=true

# Direct S3 upload — set S3_BUCKET to enable. When set, the API uploads the
# downloaded video straight into this bucket and download_url is populated
# with the resulting S3 URL. This is the recommended path for SPORTSREELZ —
# point it at sportsreelz-input (staging) or sreelz-input (production).
S3_BUCKET=

# AWS credentials for the S3 upload above
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Set true to make uploaded objects publicly readable. Leave false to receive
# a 7-day presigned URL instead (default).
S3_PUBLIC=false
